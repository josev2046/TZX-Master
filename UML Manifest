@startuml
title Binary Compilation & .WAV Generation

participant "BASIC Editor" as Editor
participant "Binary Compiler" as Bin
participant "WAV Generator" as WAV
database "Local Storage" as Disk

Editor -> Bin : Read BASIC Source
activate Bin
loop For Each Line
    Bin -> Bin : Parse Line Number (2-byte)
    loop For Each Word/Token
        Bin -> Bin : Map Keyword to ZX81 Token\n(e.g., PLOT -> 0xF2)
        Bin -> Bin : Map Alphanumeric to\nZX81 Character Set
    end
    Bin -> Bin : Append EOL (0x76)
end
Bin -> Bin : Wrap with .P System Variables\n(Header & D-File)
Bin -> WAV : Pass Uint8Array
deactivate Bin

activate WAV
WAV -> WAV : Create 2s Pilot Tone
loop For Each Byte
    loop For Each Bit (7 to 0)
        alt Bit is 1
            WAV -> WAV : Generate 9 Pulses
        else Bit is 0
            WAV -> WAV : Generate 4 Pulses
        end
        WAV -> WAV : Insert Pulse Gap (1.3ms)
    end
end
WAV -> Disk : Export .p / .wav Blob
deactivate WAV

@enduml
