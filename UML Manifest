For the Z81 app:

@startuml
title ZX81 Image Processing & Hex Conversion

actor User
participant "Browser Canvas" as Canvas
participant "Hex Engine" as Hex
participant "BASIC Editor" as Editor

User -> Canvas : Uploads Image or Draws
activate Canvas
Canvas -> Canvas : Downsample to 64x48
Canvas -> Canvas : Apply Grayscale Threshold\n(Average < 127 = Ink)
Canvas -> Hex : getImageData()
deactivate Canvas

activate Hex
loop Every Pixel (y, x)
    alt Pixel is Black (0x00)
        Hex -> Hex : Convert X to Hex (XX)
        Hex -> Hex : Convert (47-Y) to Hex (YY)
        Hex -> Hex : Append XXYY to Buffer
    end
end

Hex -> Hex : Chunk Buffer into\n400-char segments
Hex -> Editor : Output LET A$="[Chunk]"
deactivate Hex

@enduml

